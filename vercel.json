{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/ingest", "destination": "/api/ingest" },
    { "source": "/dawn", "destination": "/api/dawn" },
    { "source": "/v3", "destination": "/v3.html" },
    { "source": "/v3/", "destination": "/v3.html" }
  ],
  "functions": {
    "api/nl.js": { "maxDuration": 60 },
    "api/chat.js": { "maxDuration": 60 },
    "api/out.js": { "maxDuration": 15 }
  }
}
